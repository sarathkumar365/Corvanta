#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEV_SCRIPT="$ROOT_DIR/scripts/dev-services.sh"
BOOTSTRAP_SCRIPT="$ROOT_DIR/scripts/bootstrap-modules.sh"
RUNTIME_DIR="$ROOT_DIR/.run"
JAVA_LOG_FILE="$RUNTIME_DIR/docura-backend.log"
PYTHON_LOG_FILE="$RUNTIME_DIR/intelligence-service.log"

usage() {
  cat <<USAGE
Corvanta CLI

Usage:
  corvanta start
  corvanta stop
  corvanta health
  corvanta logs [all|java|python] [--follow|--no-follow]
  corvanta start-with-logs
  corvanta bootstrap [--clone-only]

Notes:
  - start/stop/health automatically handle stale PID cleanup and conflicting processes.
  - service logs are written to .run/ directory.
USAGE
}

colorize_stream() {
  while IFS= read -r line; do
    if [[ "$line" == *"ERROR"* ]] || [[ "$line" == *"Exception"* ]] || [[ "$line" == *"Traceback"* ]] || [[ "$line" == *"FAILED"* ]]; then
      printf '\033[31m%s\033[0m\n' "$line"
    elif [[ "$line" == *"WARN"* ]]; then
      printf '\033[33m%s\033[0m\n' "$line"
    elif [[ "$line" == *"INFO"* ]]; then
      printf '\033[32m%s\033[0m\n' "$line"
    else
      printf '%s\n' "$line"
    fi
  done
}

print_logs() {
  local target="${1:-all}"
  local follow="true"

  if [[ "${2:-}" == "--follow" ]]; then
    follow="true"
  elif [[ "${2:-}" == "--no-follow" ]]; then
    follow="false"
  elif [[ -n "${2:-}" ]]; then
    echo "Unknown logs option: ${2}" >&2
    usage
    exit 1
  fi

  case "$target" in
    java)
      if [[ ! -f "$JAVA_LOG_FILE" ]]; then
        echo "java: log file not found at $JAVA_LOG_FILE" >&2
        exit 1
      fi
      if [[ "$follow" == "true" ]]; then
        tail -n 120 -f "$JAVA_LOG_FILE" | colorize_stream
      else
        tail -n 120 "$JAVA_LOG_FILE" | colorize_stream
      fi
      ;;
    python)
      if [[ ! -f "$PYTHON_LOG_FILE" ]]; then
        echo "python: log file not found at $PYTHON_LOG_FILE" >&2
        exit 1
      fi
      if [[ "$follow" == "true" ]]; then
        tail -n 120 -f "$PYTHON_LOG_FILE" | colorize_stream
      else
        tail -n 120 "$PYTHON_LOG_FILE" | colorize_stream
      fi
      ;;
    all)
      if [[ ! -f "$JAVA_LOG_FILE" && ! -f "$PYTHON_LOG_FILE" ]]; then
        echo "logs: no log files found under $RUNTIME_DIR" >&2
        exit 1
      fi
      if [[ "$follow" == "true" ]]; then
        tail -n 120 -f "$JAVA_LOG_FILE" "$PYTHON_LOG_FILE" 2>/dev/null | colorize_stream
      else
        tail -n 120 "$JAVA_LOG_FILE" "$PYTHON_LOG_FILE" 2>/dev/null | colorize_stream
      fi
      ;;
    *)
      echo "Invalid logs target: $target" >&2
      usage
      exit 1
      ;;
  esac
}

command="${1:-}"
shift || true

case "$command" in
  start|stop|health)
    "$DEV_SCRIPT" "$command"
    ;;
  logs)
    print_logs "${1:-all}" "${2:-}"
    ;;
  start-with-logs)
    "$DEV_SCRIPT" start
    print_logs all --follow
    ;;
  bootstrap)
    "$BOOTSTRAP_SCRIPT" "$@"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage
    exit 1
    ;;
esac
